# PUBLIC INTERFACE: Dev server host configuration
# Set the hostname the CRA dev server should bind to and accept.
# This fixes "Invalid Host header" when accessing via non-default hostnames or preview URLs.
# Note: Adjust HOST to match your environment if needed.

# Bind to all interfaces so it can be reached from network/preview
HOST=0.0.0.0

# Allow host check bypass for non-standard hostnames used by preview environments.
# Use only in development. Do NOT set this in production builds.
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Optionally set PUBLIC_URL for asset paths when served behind a preview host
# PUBLIC_URL=/
